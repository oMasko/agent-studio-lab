# Choose one provider: openai, deepseek, glm, custom.
MODEL_PROVIDER=openai

# Optional: use a different model for the Subagent. Defaults to the main model.
# SUBAGENT_MODEL=your-smaller-or-specialized-model

# Optional: override the provider preset: responses or chat_completions.
# MODEL_API_MODE=responses
# WEB_SEARCH_ENABLED=true
# WEB_SEARCH_MODEL=gpt-5.6-luna

# Optional: allow trusted stdio MCP configurations to start local processes.
# Keep disabled unless you have reviewed the command, arguments, environment, and working directory.
# ALLOW_STDIO_MCP=true

# OpenAI preset (Responses API)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.6-luna

# DeepSeek preset (Responses API)
# DEEPSEEK_API_KEY=your-deepseek-key
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Zhipu GLM preset (Chat Completions API)
# ZAI_API_KEY=your-zhipu-key
# GLM_MODEL=glm-4.7
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# Any other OpenAI-compatible endpoint
# MODEL_API_KEY=your-custom-provider-key
# MODEL_NAME=your-model-id
# MODEL_BASE_URL=https://your-provider.example/v1

# Discussion room owner authentication (required for the discussion management UI).
# Generate with: openssl rand -hex 32
# Never share this with participants; generate a scoped invitation in the UI instead.
# DISCUSSION_ADMIN_TOKEN=replace-with-your-generated-secret
